# ── Database (Neon) ──────────────────────────────────────────────────────────
# Neon dashboard → your project → Connection string (pooled).
# Paste the owner connection string here first, then run `npm run db:create-role`
# — it creates a restricted app_user role (Neon's default owner role BYPASSES
# row-level security) and rewrites these two lines automatically:
#   DATABASE_URL       = app_user connection (what the app runs as)
#   DATABASE_URL_OWNER = owner connection (migrations/seeds only)
DATABASE_URL=
DATABASE_URL_OWNER=

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Clerk dashboard → API keys. Enable Organizations in Clerk settings!
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard → Webhooks → endpoint /api/webhooks/clerk → signing secret
CLERK_WEBHOOK_SECRET=
# Production runs on a PRODUCTION Clerk instance (pk_live_ / sk_live_);
# development keys are for laptops and previews only. Moving between instances
# changes every id — docs/runbooks/clerk-production-cutover.md. The cutover
# scripts read two extra keys, in .env.local and never here:
#   CLERK_SOURCE_SECRET_KEY   (defaults to CLERK_SECRET_KEY)
#   CLERK_TARGET_SECRET_KEY   (the production instance's sk_live_ key)
# Set to 1 ONLY for the minutes of a cutover: the proxy answers 503 on the
# platform's own hosts (webhooks and crons excepted; customer sites stay up).
MAINTENANCE_MODE=

# Comma-separated email addresses that get the platform-owner god view.
# (Also grantable via Clerk user publicMetadata: { "role": "superadmin" })
SUPER_ADMIN_EMAILS=

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Stripe dashboard → Developers → Webhooks → endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Connect events (account.updated) — a SEPARATE endpoint with its own secret.
# Stripe only delivers connected-account events to a Connect-enabled webhook,
# and this app keeps the two directions on two routes. See ADR 0015.
STRIPE_CONNECT_WEBHOOK_SECRET=
# ── Taking payments (Square) ─────────────────────────────────────────────────
# The CLIENT's own Square account, connected through OAuth — the provider on
# offer for card payments since 2026-09-02 (ADR 0017). Square Developer
# Console → your application → Credentials. Leave SQUARE_ENVIRONMENT unset (or
# "sandbox") until you mean real money; only "production" reaches it.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_ENVIRONMENT=sandbox
# Developer Console → Webhooks → subscription for /api/webhooks/square → signature key.
# The notification URL is part of the signature, so NEXT_PUBLIC_APP_URL must match it exactly.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Price IDs (create Products in Stripe first — see SETUP.md)
STRIPE_PRICE_OPERATIONS=      # Tier 2 monthly subscription
STRIPE_PRICE_BUSINESS_OFFICE= # Tier 3 monthly subscription
STRIPE_PRICE_ONBOARDING=      # One-time onboarding fee
STRIPE_PRICE_HOURS_5=         # One-time 5-hour retainer top-up block
STRIPE_PRICE_HOURS_10=        # One-time 10-hour retainer top-up block

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
# Powers the Discovery copilot in /admin/audits.
# console.anthropic.com → API keys → Create key
ANTHROPIC_API_KEY=

# ── Public health-check interview (/health-check) ────────────────────────────
# Salt for hashed visitor IPs (any long random string; raw IPs are never
# stored). REQUIRED for the public interview — without it the page fails
# closed and shows the at-capacity message.
INTERVIEW_IP_SALT=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tenant websites (Marketing). Every site is reachable at /sites/<slug> on the
# platform host. Set this to a domain YOU OWN and have put on Vercel's
# nameservers (a wildcard needs them) to also serve each site at
# <slug>.<SITE_DOMAIN>; src/proxy.ts rewrites those hosts. Never the platform's
# own domain — its DNS carries the mail records. Locally this defaults to
# `localhost`, so http://<slug>.localhost:3000 works with no hosts-file edit.
# SITE_DOMAIN=yosher.site

# Connecting a domain a business already owns to its website (Marketing,
# ADR 0020) adds it to THIS Vercel project through the Domains API, reads
# what Vercel says about it, and removes it again. A token with access to the
# project; the project id (prj_…) from its settings; the team id (team_…)
# when the project lives in a team. Without these the screen says the feature
# is not switched on. Never a token with more than this project's scope.
# VERCEL_API_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# --- Mail: what the PLATFORM sends (Resend) ----------------------------------
# Two mail systems live side by side and are easy to confuse. THIS block is the
# platform speaking for itself and for its tenants: share links, invoices,
# reminders, the daily digest, website enquiries, health-check leads. The block
# below it is a tenant READING its own mailbox, which is Stalwart and is
# unrelated. See docs/runbooks/platform-email.md.
RESEND_API_KEY=

# The subdomain the platform sends FROM: mail goes out as
# notifications@<this>, with the tenant's name in the display part and
# Reply-To pointed at them (src/lib/email/identity.ts).
#
# IT MUST BE A DOMAIN VERIFIED IN RESEND, AND THE TWO MUST MATCH EXACTLY.
# Unset, sendEmail() answers not_configured and nothing goes out. Set to a
# domain Resend has not verified, every send is REJECTED and the only sign is
# a failed row in outbound_emails — which is how this sat broken for two days
# in September 2026 while 44 messages, the daily digest among them, silently
# failed.
#
# A SUBDOMAIN, never the apex. It keeps this mail's reputation separate from
# the address the business uses every day, and it means the records Resend
# needs never touch the apex SPF or MX that other mail depends on.
EMAIL_FROM_DOMAIN=mail.yourcompany.com

# Where a receipt emailed into the product arrives: receipts-{token}@<this>,
# handled by /api/inbound/resend. Its own subdomain with its own MX, separate
# from EMAIL_FROM_DOMAIN because one is arriving and the other is leaving.
# Unset, the email-in panel says the feature is not configured.
INBOUND_EMAIL_DOMAIN=in.yourcompany.com

# Signs the inbound webhook. The route rejects everything when unset, so an
# unconfigured deployment cannot be fed forged receipts.
RESEND_INBOUND_WEBHOOK_SECRET=

# --- Mail: reading a mailbox inside Yosher (the inbox) -----------------------
# Where the Stalwart mail server lives. Local dev points at the Docker container
# from docker/stalwart/compose.yml; production points at your own instance.
#
# Reach local dev at http://127.0.0.1:3000 rather than localhost — Stalwart
# rejects a hostname redirect URI (RFC 8252 §7.3 wants a loopback IP literal),
# and the two are different browser origins, so expect to sign in again.
STALWART_BASE_URL=http://127.0.0.1:8080
# From `npm run mail:register-client`. A PUBLIC client — the flow uses PKCE S256
# and no secret is requested.
STALWART_CLIENT_ID=

# Which host a NEW hosted-mail domain is provisioned against: migadu | stalwart.
# Existing domains always use the provider stored on their own row, so changing
# this never moves anyone who is already set up.
#
# Get this wrong and the setup wizard renders the WRONG MX records. Publishing
# them points a live domain's mail at a host that is not holding its mailboxes,
# and unlike the sending setup there is no additive half-state to fall back to.
MAILBOX_PROVIDER=stalwart

# The mail server's PUBLIC hostname — the name its MX record points at, and the
# name mail clients connect to. Used to build the MX and SPF records the domain
# wizard shows, and to recognise a live MX as already pointing here.
#
# Only read when MAILBOX_PROVIDER=stalwart. Unset, the wizard refuses with
# "The mail server isn't configured yet", and every MX check answers false
# rather than matching everything.
STALWART_MAIL_HOSTNAME=jmap.yosherapp.com

# Outside production EVERY composed message is delivered here instead of to its
# real recipients. The envelope is rewritten; the To:/Cc: headers are left alone,
# so Sent holds a truthful record. Sending REFUSES outright if this is unset —
# without it a branch preview can mail a real customer.
EMAIL_DEV_REDIRECT=

# Authenticates the mail-sync cron route. Fails CLOSED when unset or too short:
# a cron that never runs is visible, an open endpoint is not.
CRON_SECRET=

# ── Push notifications (the mobile app, docs/modules/mobile-app.md) ──────────
# Both senders are lazy: unset, the morning digest sends no push and says so
# once in the cron's log. APNs wants the .p8 key's contents (one line with \n
# is fine); FCM wants a service account's email and private key from the
# Firebase project that owns the Android app.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.yosherapp.app
APNS_ENVIRONMENT=production
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
