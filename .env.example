# ── Database (Neon) ──────────────────────────────────────────────────────────
# Neon dashboard → your project → Connection string (pooled).
# Paste the owner connection string here first, then run `npm run db:create-role`
# — it creates a restricted app_user role (Neon's default owner role BYPASSES
# row-level security) and rewrites these two lines automatically:
#   DATABASE_URL       = app_user connection (what the app runs as)
#   DATABASE_URL_OWNER = owner connection (migrations/seeds only)
DATABASE_URL=
DATABASE_URL_OWNER=

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Clerk dashboard → API keys. Enable Organizations in Clerk settings!
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard → Webhooks → endpoint /api/webhooks/clerk → signing secret
CLERK_WEBHOOK_SECRET=

# Comma-separated email addresses that get the platform-owner god view.
# (Also grantable via Clerk user publicMetadata: { "role": "superadmin" })
SUPER_ADMIN_EMAILS=

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Stripe dashboard → Developers → Webhooks → endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Price IDs (create Products in Stripe first — see SETUP.md)
STRIPE_PRICE_OPERATIONS=      # Tier 2 monthly subscription
STRIPE_PRICE_BUSINESS_OFFICE= # Tier 3 monthly subscription
STRIPE_PRICE_ONBOARDING=      # One-time onboarding fee
STRIPE_PRICE_HOURS_5=         # One-time 5-hour retainer top-up block
STRIPE_PRICE_HOURS_10=        # One-time 10-hour retainer top-up block

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
# Powers the Discovery copilot in /admin/audits.
# console.anthropic.com → API keys → Create key
ANTHROPIC_API_KEY=

# ── Public health-check interview (/health-check) ────────────────────────────
# Salt for hashed visitor IPs (any long random string; raw IPs are never
# stored). REQUIRED for the public interview — without it the page fails
# closed and shows the at-capacity message.
INTERVIEW_IP_SALT=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Mail: reading a mailbox inside Yosher (the inbox) -----------------------
# Where the Stalwart mail server lives. Local dev points at the Docker container
# from docker/stalwart/compose.yml; production points at your own instance.
#
# Reach local dev at http://127.0.0.1:3000 rather than localhost — Stalwart
# rejects a hostname redirect URI (RFC 8252 §7.3 wants a loopback IP literal),
# and the two are different browser origins, so expect to sign in again.
STALWART_BASE_URL=http://127.0.0.1:8080
# From `npm run mail:register-client`. A PUBLIC client — the flow uses PKCE S256
# and no secret is requested.
STALWART_CLIENT_ID=

# Which host a NEW hosted-mail domain is provisioned against: migadu | stalwart.
# Existing domains always use the provider stored on their own row, so changing
# this never moves anyone who is already set up.
#
# Get this wrong and the setup wizard renders the WRONG MX records. Publishing
# them points a live domain's mail at a host that is not holding its mailboxes,
# and unlike the sending setup there is no additive half-state to fall back to.
MAILBOX_PROVIDER=stalwart

# The mail server's PUBLIC hostname — the name its MX record points at, and the
# name mail clients connect to. Used to build the MX and SPF records the domain
# wizard shows, and to recognise a live MX as already pointing here.
#
# Only read when MAILBOX_PROVIDER=stalwart. Unset, the wizard refuses with
# "The mail server isn't configured yet", and every MX check answers false
# rather than matching everything.
STALWART_MAIL_HOSTNAME=jmap.yosherapp.com

# Outside production EVERY composed message is delivered here instead of to its
# real recipients. The envelope is rewritten; the To:/Cc: headers are left alone,
# so Sent holds a truthful record. Sending REFUSES outright if this is unset —
# without it a branch preview can mail a real customer.
EMAIL_DEV_REDIRECT=

# Authenticates the mail-sync cron route. Fails CLOSED when unset or too short:
# a cron that never runs is visible, an open endpoint is not.
CRON_SECRET=
