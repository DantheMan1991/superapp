<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Long-press the icon to open already listening (res/xml/shortcuts.xml).

                The shortcut's intent names this activity EXPLICITLY, so there is
                deliberately no `<data android:scheme="yosher" />` filter here: an
                explicit intent needs none, and adding one would publish a
                `yosher://` door any app or web page could knock on, to gain
                nothing this shortcut does not already have.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        SAYING IT OUT LOUD (ADR 0049). The site records a sentence and posts it
        to /api/tell/transcribe, which means `getUserMedia` inside the WebView.

        BOTH OF THESE ARE REQUIRED AND NEITHER IS OPTIONAL. Capacitor's
        BridgeWebChromeClient already does the hard half: it catches the
        WebView's AUDIO_CAPTURE request and asks Android for
        RECORD_AUDIO + MODIFY_AUDIO_SETTINGS at runtime. But **a runtime
        request for a permission the manifest never declared is denied
        instantly, with no dialog shown** — so without these two lines the app
        asks, is refused by the system, and tells the person to grant a
        permission that does not appear in Android's settings at all, because
        an app is only listed there for what it has declared.

        That is exactly what happened: "it says the app needs permission for my
        microphone. I can't give the app permission in the phone settings."

        `android.hardware.microphone` is declared NOT required so the Play
        listing is never filtered off a device without one. Dictation is an
        optional convenience; the app works by typing on anything.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
